{
  "name": "react-native-tourly",
  "version": "0.1.1",
  "description": "A controlled, target-based guided tour overlay for React Native.",
  "keywords": [
    "react-native",
    "onboarding",
    "guided-tour",
    "product-tour",
    "spotlight"
  ],
  "license": "MIT",
  "author": "Fazalur Rahman (https://github.com/fazalur076)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itvadsoft/react-native-tourly.git"
  },
  "bugs": {
    "url": "https://github.com/itvadsoft/react-native-tourly/issues"
  },
  "homepage": "https://github.com/itvadsoft/react-native-tourly#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
